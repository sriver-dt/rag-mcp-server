# ============================================================
# RAG MCP Server 环境变量示例
# 用法：复制本文件为 .env 并填入真实值（.env 已在 .gitignore 中忽略）
#   cp .env.example .env
# ============================================================

# ---------- MCP 服务 ----------
# 日志级别：DEBUG / INFO / WARNING / ERROR
MCP_LOG_LEVEL=INFO
# 传输方式：stdio（MCP 客户端标准接入）或 sse / streamable-http
MCP_TRANSPORT=stdio
# 使用 HTTP 类传输时的监听地址与端口（stdio 模式下无需配置）
MCP_HOST=127.0.0.1
MCP_PORT=8000

# ---------- LLM（生成答案） ----------
# 支持任意 OpenAI 兼容接口（官方 / 代理 / 本地 vLLM、Ollama 等）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# ---------- Embedding（向量化） ----------
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# 向量维度，需与所选模型一致（text-embedding-3-small 为 1536）
EMBEDDING_DIM=1536

# ---------- Chroma 向量库 ----------
# 本地持久化目录（相对项目根目录）
CHROMA_PERSIST_DIR=data/chroma_db
# 默认集合名称
CHROMA_COLLECTION=rag_docs

# ---------- 文档处理 / 分块 ----------
# 单个文本块的最大字符数
CHUNK_SIZE=800
# 相邻文本块的重叠字符数
CHUNK_OVERLAP=100
# 原始文档目录
DATA_RAW_DIR=data/raw
# 分块中间产物目录
DATA_PROCESSED_DIR=data/processed

# ---------- 检索 ----------
# 每次检索返回的文本块数量
RETRIEVAL_TOP_K=5
# 是否启用重排序（true / false）
RERANK_ENABLED=false
# 重排序模型（启用时需要对应 API 支持）
RERANK_MODEL=

# ---------- 日志 ----------
LOG_DIR=logs
